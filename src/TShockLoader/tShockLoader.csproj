<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <BuildMod>false</BuildMod>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>tShockLoader</AssemblyName>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>annotations</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <Import Project="..\..\tModLoader.targets" />
  <ItemGroup>
    <Analyzer Remove="$(tMLLibraryPath)/tModCodeAssist/1.0.0/tModCodeAssist.dll" />
    <Analyzer Remove="$(tMLLibraryPath)/tModCodeAssist/1.0.0/tModCodeAssist.CodeFixes.dll" />
    <ProjectReference Include="..\TerrariaApi.Server\TerrariaApi.Server.csproj" />
    <ProjectReference Include="..\TShockAPI\TShockAPI.csproj" />
    <ProjectReference Include="..\TShockLoader.Abstractions\TShockLoader.Abstractions.csproj" />
  </ItemGroup>
  <Target Name="StagePackedLibraries" BeforeTargets="BuildMod" Condition="'$(BuildMod)' == 'true'">
    <ItemGroup>
      <_PackedLib Include="$(TargetDir)TerrariaApi.Server.dll" />
      <_PackedLib Include="$(TargetDir)TShockAPI.dll" />
      <_PackedLib Include="$(TargetDir)TShockLoader.Abstractions.dll" />
      <_VendorLib Include="$(ProjectDir)..\TShockAPI\lib\*.dll" Exclude="$(ProjectDir)..\TShockAPI\lib\SQLite.Interop.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_PackedLib);@(_VendorLib)" DestinationFolder="$(ProjectDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_VendorLib)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ProjectDir)..\TShockAPI\lib\SQLite.Interop.dll" DestinationFolder="$(ProjectDir)native" />
  </Target>
</Project>
